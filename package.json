{
  "name": "quiet-places",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check:project": "node --experimental-strip-types scripts/check-project.mjs",
    "studio:prepare": "node --experimental-strip-types scripts/studio-prepare.mjs",
    "studio": "npm run studio:prepare && vite --host 127.0.0.1 --open /tools/studio/",
    "study": "node --experimental-strip-types scripts/study.mjs",
    "mobile:assets": "node scripts/mobile-assets.mjs",
    "mobile:build": "npm run mobile:assets && tsc --noEmit && vite build --config vite.mobile.config.ts",
    "mobile:sync": "npm run mobile:build && cap sync ios",
    "mobile:open": "cap open ios",
    "mobile:preview": "vite preview --config vite.mobile.config.ts --host 127.0.0.1"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/three": "0.180.0",
    "typescript": "~5.9.2",
    "vite": "^7.1.5"
  }
}
