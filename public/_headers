# Cloudflare Workers 靜態資產的 header（對應原 Zeabur Caddy 的行為並加強快取）
# Vite 產出的檔名帶內容雜湊，可長期快取
/assets/*
  Cache-Control: public, max-age=31536000, immutable
# 檔名不帶雜湊的資產：沿用舊站的 4 小時快取
/models/*
  Cache-Control: public, max-age=14400
/textures/*
  Cache-Control: public, max-age=14400
/audio/*
  Cache-Control: public, max-age=14400
