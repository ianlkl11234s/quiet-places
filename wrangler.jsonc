// Cloudflare Workers 部署設定（取代 Zeabur 靜態部署；Zeabur 2026-12 停運）
// 網頁本體：dist/ 走 Workers 靜態資產。切正式網域步驟見 GIS 工作區 .gis-agent-system/projects/2026-10-zeabur-migration/README.md §4.7
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "quiet-places",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // 沒有前端路由（只用 query string），不存在的路徑回 404，避免 soft-404
    "not_found_handling": "none",
    // /tools/studio 等自動對應到 /tools/studio/index.html
    "html_handling": "auto-trailing-slash"
  },
  "observability": { "enabled": true }
}
